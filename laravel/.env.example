APP_NAME=CivilWatch
# Development defaults. On ANY server other people can reach, set
# APP_ENV=production and APP_DEBUG=false: local+debug echoes OTP codes in the
# send-otp response (dev autofill) and shows stack traces.
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database ─────────────────────────────────────────────────────────────
# XAMPP ships MySQL with user "root" and an empty password — the values below
# work out of the box. Import civilwatch_FINAL.sql in phpMyAdmin (or run
# `composer setup`) before starting the server. See docs/SETUP_PC.md.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=civilwatch
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# UniSMS - primary SMS provider (docs/TASKS.md task 1)
# Free API key: https://unismsapi.com/register -> https://unismsapi.com/api_keys
# Docs: https://unismsapi.com/docs/sms
# Copy your test Sender ID from the dashboard into UNISMS_SENDER_ID.
# Leave UNISMS_SECRET_KEY empty to keep the old dev behaviour (OTP echoed in
# the response while APP_DEBUG=true).
UNISMS_SECRET_KEY=
UNISMS_SENDER_ID=
UNISMS_BASE_URL=https://unismsapi.com/api
